# ---- TAMUR Weather Bot configuration ----
# Bu faylni ".env" nomi bilan nusxalang va qiymatlarni to'ldiring.
# Sirlar (token/key) hech qachon git ga commit qilinmaydi.

NODE_ENV=development

# ---- Hudud (final production contract: Buxoro) ----
WEATHER_CITY=Buxoro
WEATHER_LAT=39.7747
WEATHER_LON=64.4286
WEATHER_TIMEZONE=Asia/Tashkent

# ---- WeatherAPI.com ----
WEATHERAPI_KEY=

# Legacy adapter uchun; production oqimida MET Norway ishlatilmaydi.
MET_USER_AGENT=TamurWeatherBot/1.0 contact@example.com

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=
# Production: FAQAT BITTA guruh (masalan -1002087046851).
# (Kod vergul bilan bir nechtasini qo'llaydi, lekin production lock bitta talab qiladi.)
TELEGRAM_CHAT_ID=
# Ixtiyoriy: xatoliklar shu chatga yuboriladi.
ADMIN_CHAT_ID=

# ---- Production lock ----
# Local/dev uchun false. Render production'da true bo'ladi.
PRODUCTION_LOCK_ENABLED=false
# Lock yoqilganda TELEGRAM_CHAT_ID aynan shu ro'yxatga teng bo'lishi shart.
PRODUCTION_LOCK_CHAT_IDS=

# ---- Tarmoq ----
REQUEST_TIMEOUT_MS=9000
REQUEST_MAX_ATTEMPTS=3
