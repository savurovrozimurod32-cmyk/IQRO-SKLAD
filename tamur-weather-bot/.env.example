# ---- TAMUR Weather Bot configuration ----
# Bu faylni ".env" nomi bilan nusxalang va qiymatlarni to'ldiring.
# Sirlar (token/key) hech qachon git ga commit qilinmaydi.

NODE_ENV=development

# ---- Hudud (default: Buxoro) ----
WEATHER_CITY=Buxoro
WEATHER_LAT=39.7747
WEATHER_LON=64.4286
WEATHER_TIMEZONE=Asia/Tashkent

# ---- WeatherAPI.com ----
# https://www.weatherapi.com/ dan bepul API key oling.
# Bo'sh qolsa WeatherAPI provideri o'chiriladi (Open-Meteo + MET Norway ishlaydi).
WEATHERAPI_KEY=

# ---- MET Norway (Locationforecast) ----
# MET Norway noyob va aloqa ma'lumotli User-Agent talab qiladi.
# O'zingizning haqiqiy aloqa emailingizni yozing.
MET_USER_AGENT=TamurWeatherBot/1.0 contact@example.com

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Ixtiyoriy: xatoliklar shu chatga yuboriladi (admin/log kanali).
ADMIN_CHAT_ID=

# ---- Consensus ----
# Kamida nechta provider muvaffaqiyatli bo'lsa rasm yuboriladi (default 2).
MIN_SUCCESSFUL_SOURCES=2

# ---- Tarmoq (ixtiyoriy, default qiymatlar mavjud) ----
# Har bir provider so'rovi uchun timeout (ms).
REQUEST_TIMEOUT_MS=9000
# Har bir provider uchun maksimal urinishlar soni.
REQUEST_MAX_ATTEMPTS=3
